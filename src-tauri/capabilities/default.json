{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Albedo main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-seek",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/.claude/projects",
        "$HOME/.claude/projects/**",
        "$HOME/.claude/settings.json",
        "$HOME/.claude/cache/model-catalog",
        "$HOME/.claude/cache/model-catalog/*",
        "$HOME/.albedo",
        "$HOME/.albedo/**",
        "$HOME/agents",
        "$HOME/agents/**"
      ]
    },

    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": true
        },
        {
          "name": "open",
          "cmd": "open",
          "args": true
        },
        {
          "name": "phpstorm",
          "cmd": "phpstorm",
          "args": true
        }
      ]
    },

    "dialog:default",
    "dialog:allow-open"
  ]
}
